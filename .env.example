# TalentMatch AI - Environment Variables Template
PROJECT_NAME="TalentMatch AI"
ENVIRONMENT="development"

# Backend Configuration
PORT=8000
HOST="0.0.0.0"
SECRET_KEY="talentmatch-ai-insecure-default-change-in-production-super-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default, can be replaced with PostgreSQL)
DATABASE_URL="sqlite:///./talentmatch.db"
# Example PostgreSQL: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talentmatch"

# Upload Configuration
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR="./uploads"

# AI Matching Weights (configurable, total = 1.0)
WEIGHT_SKILLS=0.50
WEIGHT_KEYWORDS=0.30
WEIGHT_EXPERIENCE=0.20

# Frontend Configuration (for Vite)
VITE_API_URL="http://localhost:8000/api"

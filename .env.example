# HireMatch AI - Environment Variables Template
PROJECT_NAME="HireMatch AI"
ENVIRONMENT="development"

# Backend Configuration
PORT=8000
HOST="0.0.0.0"
SECRET_KEY="replace-with-a-cryptographically-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated allowed frontend origins; wildcard '*' is forbidden in production)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Database Configuration (SQLite default for local dev; PostgreSQL for Render production)
DATABASE_URL="sqlite:///./talentmatch.db"
# Example PostgreSQL: DATABASE_URL="postgresql://user:password@host:5432/hirematch"

# Upload Configuration (Note: Render free tier filesystem is ephemeral across restarts/deploys)
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR="./uploads"

# AI Matching Weights (configurable, total = 1.0)
WEIGHT_SKILLS=0.50
WEIGHT_KEYWORDS=0.30
WEIGHT_EXPERIENCE=0.20

# Frontend Configuration (for Vite build/dev)
VITE_API_URL="http://localhost:8000/api"
